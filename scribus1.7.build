#!/bin/bash
#
. build_funcs

TARNAME=scribus
TARNAMEEXTRA=
TARDIR=${SOURCE}/s
#TAR_EXT=.tar.gz
VERSION=1.7.3
VERSIONEXTRA=
BUILD=2

#TAR_PROG=
#TAR_OPTS=
PKGNAME=scribus1_7
#PKGVERSION=
#BUILD_SUFFIX=
#ARCH=noarch

DICTS_DIR=${TARDIR}/scribus/dicts/spelling

FULL_TARNAME=${TARDIR}/${TARNAME}${TARNAMEEXTRA}-${VERSION}${VERSIONEXTRA}${TAR_EXT}

pre_unpack

PKG=/tmp/package-${PKGNAME}

if [ ! -f ${FULL_TARNAME} ]
then
  echo Can\'t find ${FULL_TARNAME}
  exit
fi

if [ ! -d ${TARNAME}-${VERSION} ]
then
${TAR_PROG} ${TAR_OPTS} ${FULL_TARNAME}
#mv ${TARNAME}-${VERSION} ${TARNAME}-${VERSION}

if [ ! -d ${TARNAME}-${VERSION} ]
then
  echo "${TARNAME}-${VERSION} directory not found"
  exit
fi

(cd ${TARNAME}-${VERSION}
# patch -p1 -b -z .orig < ${CWD}/scribus-1.6.6.diff
)
fi

pre_configure

cd ${TARNAME}-${VERSION}

fix_perms

#export QTDIR=/opt/kde3/lib/qt3
#PATH=/opt/kde3/lib/qt3/bin:${PATH}
mkdir _BuilD_
cd _BuilD_

if [ ${DO_CONFIGURE} == "yes" ]
then
#CC=clang \
#CXX=clang++ \

cmake -DCMAKE_INSTALL_PREFIX:PATH=/opt/scribus \
      -DWANT_CAIRO=1 \
      -DLIB_SUFFIX=${LIBDIRSUFFIX} \
      -DWANT_CPP20=1 \
      -DWANT_NORPATH=true \
      ..

#      -DWANT_QT6=true \


fi

if [ ${DO_MAKE} == "yes" ]
then
make ${NUM_JOBS} || exit
fi

if [ ${DO_INSTALL} != "yes" ]
then
  exit
fi

make install DESTDIR=${PKG}

cd ..

mkdir -p ${PKG}/opt/scribus/share/applications
# ${PKG}/opt/scribus/share/pixmaps
cp scribus.desktop ${PKG}/opt/scribus/share/applications
#cp scribus/icons/scribusicon.png ${PKG}/opt/scribus/share/pixmaps/scribusicon.png
#cp scribus/icons/scribusdoc.png ${PKG}/opt/scribus/share/pixmaps/x-scribus.png

#(cd  ${PKG}/opt/scribus/share/scribus/icons/1_5_1
#  for n in lab.png spot.png register.png
#  do
#    [ ! -e $n ] && ln -s ../1_5_0/$n .
#  done
#)


#strip_binaries

mkdir -p ${PKG}/opt/scribus/share/scribus/dicts/spelling
cp $DICTS_DIR/* ${PKG}/opt/scribus/share/scribus/dicts/spelling

fix_links

compress_manpages

compress_info

ln -s ${TARNAME} ${PKG}/opt/scribus/share/doc/${TARNAME}-${VERSION}

cp -a \
  AUTHORS COPYING* INSTALL NEWS PLANS README* TODO \
  ${PKG}/opt/scribus/share/doc/${TARNAME}-${VERSION}

fix_docs

#-----handy-ruler-for-slack-desc-width-------------------------------|
make_slack_desc << EOF "desktop open source page layout program"
Scribus is a desktop open source page layout program with the aim of
producing commerical grade output in PDF and Postscript, primarily,
though not exclusively for Linux. Scirbus runs natively on Linux, BSD,
OS/2, Solaris, and Win32.

EOF

post_install

cd ${PKG}
su -c "chown -R root:root ${PKG}; \
find . -type d -exec chmod 755 {} \; ; \
makepkg -l y -c n ${PKGDIR}${PKGNAME}-${PKGVERSION}-${ARCH}-${BUILD}${BUILD_SUFFIX}.tgz; \
chown -R ${USERNAME}:${GROUP} ${PKG}"
