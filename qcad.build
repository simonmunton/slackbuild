#!/bin/bash
#
. build_funcs

TARNAME=qcad
TARNAMEEXTRA=
TARSEP="-"
TARDIR=${SOURCE}/q/qcad
#TAR_EXT=.tar.gz
VERSION=3.33.1.0
VERSIONEXTRA=
BUILD=1

WEBPAGE="http://www.qcad.org/"

#TAR_PROG=
#TAR_OPTS=
#PKGNAME=
#PKGVERSION=
#BUILD_SUFFIX=
#ARCH=noarch


FULL_TARNAME=${TARDIR}/${TARNAME}${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA}${TAR_EXT}

pre_unpack


if [ ! -f ${FULL_TARNAME} ]
then
  echo Can\'t find ${FULL_TARNAME}
  exit
fi

if [ ! -d ${TARNAME}-${VERSION} ]
then 
${TAR_PROG} ${TAR_OPTS} ${FULL_TARNAME}
#mv ${TARNAME}-${VERSION}-* ${TARNAME}-${VERSION}

${TAR_PROG} ${TAR_OPTS} ${FULL_TARNAME}
${TAR_PROG} ${TAR_OPTS} ${TARDIR}/qcadjsapi${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA}${TAR_EXT}
${TAR_PROG} ${TAR_OPTS} ${TARDIR}/qtjsapi${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA}${TAR_EXT}
ln -s qcad${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA} qcad
ln -s qtjsapi${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA} qtjsapi
ln -s qcadjsapi${TARNAMEEXTRA}${TARSEP}${VERSION}${VERSIONEXTRA} qcadjsapi

if [ ! -d ${TARNAME}-${VERSION} ]
then 
  echo "${TARNAME}-${VERSION} directory not found"
  exit
fi

(cd ${TARNAME}-${VERSION}
# patch -p1 < ${CWD}/

)
fi

# check there is only one qcad directory or build will go wrong
if [ $(ls | grep qcad- | wc -l) -ne 1 ]
then
  echo "More than one qcad folder, please fix:"
  ls | grep qcad-
  exit
fi

pre_configure

cd ${TARNAME}-${VERSION}

fix_perms

#mkdir _BuilD_
#cd _BuilD_

#PATH=/usr/lib${LIBDIRSUFFIX}/qt5/bin/:${PATH}

if [ ${DO_CONFIGURE} == "yes" ]
then
:
#CFLAGS="${SLKCFLAGS}" \
#CXXFLAGS="${SLKCFLAGS}" \
#./configure --prefix=/usr \
#            --sysconfdir=/etc \
#            --libdir=/usr/lib${LIBDIRSUFFIX} \
#            --localstatedir=/var/lib \
#	    --mandir=/usr/man

cmake -DCMAKE_C_FLAGS:STRING="${SLKCFLAGS}" \
      -DCMAKE_CXX_FLAGS:STRING="${SLKCFLAGS}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/qcad \
      -DMAN_INSTALL_DIR=/usr/man \
      -DSYSCONF_INSTALL_DIR=/etc \
      -DBUILD_QT6=ON \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -DCMAKE_INSTALL_RPATH=/opt/qcad \
      -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
      .

cd ../qtjsapi-${VERSION}
cmake \
    -DCMAKE_C_FLAGS:STRING="${SLKCFLAGS}" \
    -DCMAKE_CXX_FLAGS:STRING="${SLKCFLAGS}" \
    -DCMAKE_INSTALL_RPATH=/opt/qcad \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DCMAKE_BUILD_TYPE=Release \
    .

cd ../qcadjsapi-${VERSION}
cmake \
    -DCMAKE_C_FLAGS:STRING="${SLKCFLAGS}" \
    -DCMAKE_CXX_FLAGS:STRING="${SLKCFLAGS}" \
    -DCMAKE_INSTALL_RPATH=/opt/qcad \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DCMAKE_BUILD_TYPE=Release \
    .

cd ../${TARNAME}-${VERSION}

fi


if [ ${DO_MAKE} == "yes" ]
then
make ${NUM_JOBS} || exit

cd ../qtjsapi-${VERSION}
make ${NUM_JOBS} || exit

cd ../qcadjsapi-${VERSION}
make ${NUM_JOBS} || exit

cd ../${TARNAME}-${VERSION}
fi

if [ ${DO_INSTALL} != "yes" ]
then
  exit
fi

#cd ..

mkdir -p ${PKG}/opt/qcad/
cp -a release/* ${PKG}/opt/qcad/
rm ${PKG}/opt/qcad/*.a

cp -pr examples fonts libraries linetypes patterns scripts themes ts plugins readme.txt ${PKG}/opt/qcad/

#mkdir -p ${PKG}/usr/share/man/man1 ${PKG}/usr/share/{pixmaps,icons/hicolor/scalable/apps,applications}
# install man
install -Dm644 qcad.1 ${PKG}/usr/share/man/man1/qcad.1
# desktop
install -Dm644 scripts/qcad_icon.png ${PKG}/usr/share/pixmaps/org.qcad.QCAD.png
install -Dm644 scripts/qcad_icon.svg ${PKG}/usr/share/icons/hicolor/scalable/apps/org.qcad.QCAD.svg
install -Dm644 qcad.desktop ${PKG}/usr/share/applications/qcad.desktop

mkdir -p ${PKG}/usr/bin
cat > ${PKG}/usr/bin/qcad << EOF
#! /bin/bash

LD_LIBRARY_PATH=/opt/qcad /opt/qcad/qcad-bin "\$@"

#exec /opt/qcad/qcad-bin "\$@"
EOF

chmod +x ${PKG}/usr/bin/qcad

#make install DESTDIR=${PKG}

strip_binaries

fix_links

compress_manpages

compress_info

cp -a \
  AUTHORS COPYING* INSTALL NEWS PLANS README* readme*TODO \
  ${PKG}/usr/doc/${TARNAME}-${VERSION}

fix_docs

#-----handy-ruler-for-slack-desc-width-------------------------------|
make_slack_desc << EOF "CAD application"
QCAD is an application for computer aided drafting in two dimensions 
(2d). With QCAD you can create technical drawings such as plans for 
buildings, interiors, mechanical parts or schemas and diagrams. QCAD 
works on Windows, Mac OS X and many Linux and Unix Systems. The 
source code of the QCAD community edition is released under the GPL 
(Open Source).

EOF

post_install

cd ${PKG}
su -c "chown -R root:root ${PKG}; \
find . -type d -exec chmod 755 {} \; ; \
makepkg -l y -c n ${PKGDIR}${PKGNAME}-${PKGVERSION}-${ARCH}-${BUILD}${BUILD_SUFFIX}.tgz; \
chown -R ${USERNAME}:${GROUP} ${PKG}"
